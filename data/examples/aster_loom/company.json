{
  "company_id": "aster_loom",
  "company_name": "Aster & Loom",
  "description": "A premium sustainable clothing company focused on timeless garments, responsible materials, and transparent production.",
  "industry": "Fashion and apparel",

  "assistant": {
    "name": "Ster",
    "title": "AI Assistant",
    "default_language": "English"
  },

  "modes": {
    "customer_support": {
      "enabled": true,
      "default": true
    },
    "internal_knowledge": {
      "enabled": false
    }
  },

  "branding": {
    "assets": {
      "logo": "logo.png",
      "favicon": "favicon.ico",
      "assistant_avatar": "assistant_avatar.png"
    },
    "colors": {
      "primary": "#243B36",
      "secondary": "#D8C3A5",
      "accent": "#E07A5F",
      "background": "#FAF8F3",
      "text": "#1F2933"
    },
    "fonts": {
      "heading": "Playfair Display",
      "body": "Inter"
    },
    "ui_theme": "premium"
  },

  "conversation": {
    "tone": "friendly and helpful",
    "response_length": "concise",
    "formality_level": "professional",
    "greeting": {
      "enabled": true,
      "message": "Hello, I'm Ster from Aster & Loom. How can I help you today?"
    }
  },

  "customer_support": {
    "chat_headline": "Aster & Loom Customer Care",
    "chat_description": "Find information about our products, materials, production, policies, care instructions, and latest collections.",
    "placeholder": "Ask about Aster & Loom products, materials, shipping, or returns...",
    "loading_message": "One moment — I'm checking Aster & Loom information...",
    "allowed_topics": [
      "products",
      "materials",
      "manufacturing",
      "shipping",
      "returns",
      "care instructions",
      "availability"
    ],
    "support_contacts": {
      "name": "Aster & Loom Customer Support",
      "email": "support@example.com"
    },
    "fallback_message": "I could not find enough information to answer that confidently."
  },

  "prompts": {
    "customer_support": "customer_support.txt"
  },

  "knowledge_bases": {
    "customer_support": {
      "documents_path": "documents/customer_support"
    }
  },

  "visibility": {
    "customer_support": {
      "show_citations": false
    }
  }
}